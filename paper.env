# ─────────────────────────────────────────────────────────────
# Paper version — the single source of truth.
#
# Read by:
#   start.sh                       (which jar to launch)
#   sample-plugins/build.gradle.kts (which API to compile against)
#
# Changing the version means editing this file only. Keeping the server and
# the plugin API in lockstep matters: compiling against a different build than
# you run is a classic source of NoSuchMethodError at runtime.
#
# To update, find the current build:
#   curl -s https://fill.papermc.io/v3/projects/paper/versions/<version>/builds/latest
# then set the values below, download the new jar, and verify its checksum.
# See README.md → "Installing from scratch".
# ─────────────────────────────────────────────────────────────

PAPER_MC_VERSION=26.2
PAPER_BUILD=103

# The Maven coordinate version for the plugin API. Mirrors the two above.
PAPER_API_VERSION=26.2.build.103-stable
